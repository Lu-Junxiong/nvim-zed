// Zed user settings: https://zed.dev/docs/reference/all-settings
{
    // 外观与字号
    "buffer_font_family": "JetBrainsMono Nerd Font",
    "ui_font_family": "JetBrainsMono Nerd Font",
    "mermaid_font_family": "JetBrainsMono Nerd Font",
    "auto_signature_help": true,
    "theme": {
        "mode": "light",
        "light": "One Light",
        "dark": "One Dark"
    },
    "icon_theme": "Material Icon Theme",
    "ui_font_size": 20,
    "buffer_font_size": 20,

    // 编辑与 Python
    "vim_mode": true,
    "format_on_save": "on",
    "languages": {
        "Python": {
            "enable_language_server": true,
            "language_servers": ["ty", "ruff", "path-server-lsp"],
            "format_on_save": "on",
            "formatter": {
                "language_server": {
                    "name": "ruff"
                }
            },
            "completions": {
                "words": "enabled",
                "words_min_length": 2,
                "lsp": true
            }
        }
    },
    "file_finder": {
        "file_icons": true
    },

    // 面板布局
    "project_panel": {
        "dock": "right",
        "default_width": 400,
        "entry_spacing": "standard",
        "indent_size": 16,
        "indent_guides": {
            "show": "always"
        },
        "file_icons": true,
        "folder_indicator": "both",
        "bold_folder_labels": true,
        "auto_fold_dirs": true,
        "auto_reveal_entries": true,
        "sticky_scroll": true,
        "sort_mode": "directories_first",
        "sort_order": "default",
        "git_status": true,
        "show_diagnostics": "all",
        "hide_root": false,
        "hide_hidden": false
    },
    "git_panel": {
        "dock": "right",
        "default_width": 400,
        "tree_view": true
    },
    "outline_panel": {
        "dock": "right",
        "default_width": 400
    },
    "terminal": {
        "dock": "bottom",
        "default_height": 280,
        "font_family": "JetBrainsMono Nerd Font",
        "font_size": 20
    },
    "debugger": {
        "button": false
    },
    "collaboration_panel": {
        "button": false
    },

    // Git 差异
    "git": {
        "inline_blame": {
            "enabled": false
        },
        "diff_base": "default_branch"
    },

    // WSL 连接
    "wsl_connections": [
        {
            "distro_name": "Ubuntu-24.04",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/lujx"]
                }
            ]
        }
    ],

    // 更新、隐私与会话
    "auto_update": false,
    "disable_ai": true,
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
        "anthropic_retention": false
    },
    "session": {
        "trust_all_worktrees": true
    },
    "autosave": {
        "after_delay": {
            "milliseconds": 1000
        }
    }
}
